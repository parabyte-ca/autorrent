# AutoRrent environment variables
# Copy this file to .env and edit as needed.
# Most settings are configured via the Settings page in the UI.

# SQLite database location (inside the container — do not change unless you know what you're doing)
DATABASE_URL=sqlite:////app/data/autorrent.db

# In-app upgrade support
# Path inside the container to the shared upgrade folder (must be mounted from the host)
APP_UPGRADE_FOLDER=/upgrade
# GitHub repository URL used for release checks (default: https://github.com/parabyte-ca/autorrent)
# APP_SOURCE_URL=https://github.com/parabyte-ca/autorrent
# Set to false to disable the automatic daily release check
# APP_UPDATE_CHECK=true
# Extra flags passed to update.sh by the upgrade helper (only --pull and --skip-preflight are accepted).
# --pull is chosen automatically when docker-compose.yml runs the published image, so this is rarely needed.
# APP_UPGRADE_ARGS=--skip-preflight
